{
  "name": "music-flow-card",
  "version": "0.0.0",
  "description": "Audio Flow style routing card for Home Assistant: pick a Music Assistant source, stream it through a Chromecast, and route it to Yamaha and Monoprice zones with live volume control.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/trooperthorn/ha_card_music"
  },
  "scripts": {
    "dev": "vite serve dev --config vite.config.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src dev scripts",
    "test": "vitest run",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "lit": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
